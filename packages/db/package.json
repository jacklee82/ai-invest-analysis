{
  "name": "@my-better-t-app/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "db:local": "turso dev --db-file local.db",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run scripts/seed.ts",
    "db:seed-large": "bun run scripts/seed-large.ts"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.2",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.7",
    "uuid": "^13.0.0",
    "zod": "catalog:"
  }
}
